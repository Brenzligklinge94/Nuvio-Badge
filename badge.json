      "isEnabled": true,
      "name": "SeaDex Best",
      "pattern": "(?i)\\b(?:seadex[\\s._-]?best|best[\\s._-]?release)\\b|ʙᴇsᴛ ʀᴇʟᴇᴀsᴇ",
